{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "visual-agent-chat",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // index.html and friends are served straight from the edge; only /api/* reaches the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },

  // Claude Haiku 5.5 and Exa search both go through AI Gateway on this binding, billed to the account's AI Gateway credits.
  "ai": { "binding": "AI", "remote": true },
  "vars": { "GATEWAY_ID": "default", "MODEL": "anthropic/claude-haiku-5.5" },

  // Durable Objects with their own SQLite databases: one per chat thread, and one exact rate-limit counter per IP / visitor.
  "durable_objects": { "bindings": [
    { "name": "THREAD", "class_name": "Thread" },
    { "name": "RATE", "class_name": "Limiter" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Thread"] },
    { "tag": "v2", "new_sqlite_classes": ["Limiter"] }
  ]

}
