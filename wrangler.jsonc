{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "visual-agent-chat",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // index.html and friends are served straight from the edge; only /api/* reaches the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },

  // Claude Haiku 5.5 and Exa search both go through AI Gateway on this binding, billed to the account's AI Gateway credits.
  "ai": { "binding": "AI", "remote": true },
  "vars": { "GATEWAY_ID": "default", "MODEL": "anthropic/claude-haiku-5.5" },

  // One Durable Object (with its own SQLite database) per chat thread.
  "durable_objects": { "bindings": [{ "name": "THREAD", "class_name": "Thread" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Thread"] }],

  // Caps on messages so nobody can run up the bill: 20 a minute per visitor cookie, 60 a minute per IP (offices share one).
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ]
}
